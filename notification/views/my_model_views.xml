<odoo>
  <record id="view_my_model_form" model="ir.ui.view">
    <field name="name">my.model.main.form</field>
    <field name="model">my.model.main</field>
    <field name="arch" type="xml">
      <form string="My Form">
        <sheet>
          <group>
            <field name="name"/>
            <field name="user_id"/>
          </group>
          <notebook>
            <page string="Model Lines">
              <field name="line_ids">
                <tree editable="bottom">
                  <!-- <field name="custom_model_id"/> -->
                  <field name="field_id"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_my_model_tree" model="ir.ui.view">
    <field name="name">my.model.main.tree</field>
    <field name="model">my.model.main</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="user_id"/>
      </tree>
    </field>
  </record>

  <record id="action_my_model_main" model="ir.actions.act_window">
    <field name="name">My Model Forms</field>
    <field name="res_model">my.model.main</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_my_model_root" name="My App"/>
  <menuitem id="menu_my_model_main" name="Forms" parent="menu_my_model_root"/>
  <menuitem id="menu_my_model_action" name="Manage Forms" parent="menu_my_model_main" action="action_my_model_main"/>
</odoo>
