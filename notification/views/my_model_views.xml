<odoo>
  <record id="view_my_model_form" model="ir.ui.view">
    <field name="name">my.model.main.form</field>
    <field name="model">my.model.main</field>
    <field name="arch" type="xml">
      <form string="Notification">
        <sheet>
          <group>
            <field name="name"/>
            <field name="user_ids" widget="many2many_tags"/>
          </group>
          <group>
          <field name="custom_model_id"/>
          </group>
          <notebook>
            <page string="Model Lines">
              <field name="line_ids">
                <tree editable="bottom">                  
                  <!-- <field name="field_id"/> -->
                  
                  <field name="condition"/>
                  <field name="msg"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_my_model_tree" model="ir.ui.view">
    <field name="name">my.model.main.tree</field>
    <field name="model">my.model.main</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
            <field name="user_ids" widget="many2many_tags"/>
        <!-- <field name="user_id"/> -->
      </tree>
    </field>
  </record>

  <record id="action_my_model_main" model="ir.actions.act_window">
    <field name="name">Notification</field>
    <field name="res_model">my.model.main</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_my_model_root" name="Notification"/>
  <menuitem id="menu_my_model_main" name="Notification" parent="menu_my_model_root"/>
  <menuitem id="menu_my_model_action" name="Notification" parent="menu_my_model_main" action="action_my_model_main"/>
</odoo>
