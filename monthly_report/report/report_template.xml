<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="monthly_reports">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">

                <div class="header">
                    <div class="row mt-2">
                        <div class="col-2">
                            <t t-set="comp" t-value=""/>
                            <t t-foreach="data" t-as="vals">
                                <t t-if="vals.get('id')"/>
                                <t t-set="comp" t-value="env['res.company'].search([('id','=',vals['id'])])"/>
                            </t>
                            
                            <div class="row">
                                <div class="col-12" style="text-align: center;">
                                    <img t-if="comp.logo" t-att-src="image_data_uri(comp.logo)" style="max-height: 100px; width: 100; margin-top: 5px;" alt="header"/>
                                    <!--margin-left: -10px;-->
                                </div>
                            </div>
                        </div>
                        <div class="col-10">
                            <div class="row text-center">
                                <h1>NASA CHEMICALS</h1>
                            </div>
                            <div class="row text-center">
                                <h1>Month Wise Purchase Order Report</h1>
                            </div>
                            <div class="row">
                                <div class="col-12" style="text-align:center">
                                    <t t-if="other['date_from']">
                                        <b>From:</b>
                                        <t t-esc="other['date_from']"/>
                                    </t>
                                    <br/>
                                    <t t-if="other['date_to']">
                                        <b>To:</b>
        
                                        <t t-esc="other['date_to']"/>
                                    </t>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                    <!--</div>-->
                </div>
                
                <div class="page">
                    <div class="row mt-5 mb-3">
                        <div class="col-12">
<table class="table table-sm o_account_report_table">
    <thead>
        <tr>
            <th rowspan="2">Account</th>
            <t t-foreach="range(0, (date_to.year - date_from.year) * 12 + date_to.month - date_from.month + 1)" t-as="i">
                <th colspan="2">
                    <t t-set="month_date" t-value="date_from + relativedelta(months=i)"/>
                    <t t-esc="month_date.strftime('%B %Y')"/>
                </th>
            </t>
            <th colspan="2">Total</th>
        </tr>
        <tr>
            <t t-foreach="range(0, (date_to.year - date_from.year) * 12 + date_to.month - date_from.month + 1)" t-as="i">
                <th>Quantity</th>
                <th>Amount</th>
            </t>
            <th>Quantity</th>
            <th>Amount</th>
        </tr>
    </thead>
    <tbody>
        <!-- Initialize an empty dictionary for month totals -->
        <t t-set="month_totals" t-value="{}"/>

        <t t-foreach="data" t-as="line">
            <tr>
                <td>
                    <span t-esc="line['item'].get('en_US', '-')"/>
                </td>
                <t t-set="date_from" t-value="datetime.strptime(date_from, '%Y-%m-%d').date() if isinstance(date_from, str) else date_from"/>
                <t t-set="date_to" t-value="datetime.strptime(date_to, '%Y-%m-%d').date() if isinstance(date_to, str) else date_to"/>

                <!-- Initialize total quantity & amount per account -->
                <t t-set="account_total_qty" t-value="0"/>
                <t t-set="account_total_amount" t-value="0"/>

                <t t-foreach="range(0, (date_to.year - date_from.year) * 12 + date_to.month - date_from.month + 1)" t-as="i">
                    <t t-set="month_date" t-value="date_from + relativedelta(months=i)"/>
                    <t t-set="qty_key" t-value="month_date.strftime('qty_%Y_%m')"/>
                    <t t-set="amount_key" t-value="month_date.strftime('amount_%Y_%m')"/>

                    <t t-set="qty_value" t-value="line.get(qty_key, 0)"/>
                    <t t-set="amount_value" t-value="line.get(amount_key, 0)"/>

                    <!-- Sum total per account -->
                    <t t-set="account_total_qty" t-value="account_total_qty + qty_value"/>
                    <t t-set="account_total_amount" t-value="account_total_amount + amount_value"/>

                    <!-- Workaround: Use temporary variables -->
                    <t t-set="prev_qty_total" t-value="month_totals.get(qty_key, 0)"/>
                    <t t-set="prev_amount_total" t-value="month_totals.get(amount_key, 0)"/>

                    <!-- Update dictionary manually -->
                    <t t-set="month_totals" t-value="month_totals.update({qty_key: prev_qty_total + qty_value, amount_key: prev_amount_total + amount_value}) or month_totals"/>

                    <td>
                        <span t-esc="qty_value if qty_value else '-'"/>
                    </td>
                    <td>
                        <span t-esc="amount_value if amount_value else '-'"/>
                    </td>
                </t>

                <!-- Total per account -->
                <td>
                    <strong><span t-esc="account_total_qty"/></strong>
                </td>
                <td>
                    <strong><span t-esc="account_total_amount"/></strong>
                </td>
            </tr>
        </t>

        <!-- Grand Total Row -->
        <tr class="table-success">
            <td><strong>Total</strong></td>
            <t t-foreach="range(0, (date_to.year - date_from.year) * 12 + date_to.month - date_from.month + 1)" t-as="i">
                <t t-set="month_date" t-value="date_from + relativedelta(months=i)"/>
                <t t-set="qty_key" t-value="month_date.strftime('qty_%Y_%m')"/>
                <t t-set="amount_key" t-value="month_date.strftime('amount_%Y_%m')"/>
                
                <td><strong><span t-esc="month_totals.get(qty_key, 0)"/></strong></td>
                <td><strong><span t-esc="month_totals.get(amount_key, 0)"/></strong></td>
            </t>
            <td>—</td> <!-- Placeholder for total column -->
            <td>—</td>
        </tr>
    </tbody>
</table>




