<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sales_target_wizard" model="ir.ui.view">
        <field name="name">Sales Target Report</field>
        <field name="model">sales.target.report</field>
        <field name="arch" type="xml">
            <form string="Sales Target Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="customer_ids" widget="many2many_tags"/>
                        <field name="region_ids" widget="many2many_tags"/>
                        <field name="sub_region_ids" widget="many2many_tags" />
                    </group>
                </group>
                <footer>
                    <button name="print_report" type="object" string="Print" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="sales_target_report_action" model="ir.actions.act_window">
        <field name="name">Sales Target Report</field>
        <field name="res_model">sales.target.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="sales_target_menu_id"
                name="Sales Target Report"
                parent="account.menu_finance_reports"
                action="sales_target_report_action"
    />
</odoo>