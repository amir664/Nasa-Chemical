<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sales_target_reports">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="header-row" style="text-align:center; margin-top: 3px;">
                        <h1>
                            Sales Target Report
                        </h1>
                    </div>
                    <div class="row">
                        <div class="col-6" style="margin-top: 10px;">
                            <t t-if="other['date_from']">
                                <div style="margin-bottom: 3px; margin-left: 8px;"> 
                                    <b>From:</b>
                                    <t t-esc="other['date_from']"/>
                                </div>
                            </t>
                            
                            <t t-if="other['date_to']">
                                <div style="margin-top: 3px; margin-left: 8px;"> 
                                    <b>To:</b>
                                    <t t-esc="other['date_to']"/>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="row mt-5 mb-3">
                            <table style="border-collapse:collapse; width: 100%; font-family: Arial, sans-serif;" class="table-borderless">
                                <thead>
                                    <tr>
                                        <th style="text-align:center;border-bottom:1px solid black;padding:4px;width:200px;font-weight:bold;">
                                            <b>REGION</b>
                                        </th>
                                        <th style="text-align:center;border-bottom:1px solid black;padding:4px;width:200px;font-weight:bold;">
                                            <b>CLIENTS</b>
                                        </th>
                                        <th style="text-align:center;border-bottom:1px solid black;padding:4px;width:150px;font-weight:bold;">
                                            <b>STATUS</b>
                                        </th>
                                        <th style="text-align:center;border-bottom:1px solid black;padding:4px;width:150px;font-weight:bold;">
                                            <b>TOWN</b>
                                        </th>
                                        <th style="text-align:center;border-bottom:1px solid black;padding:4px;width:120px;font-weight:bold;">
                                            <b>MONTH TARGET</b>
                                        </th>
                                        <th style="text-align:center;border-bottom:1px solid black;padding:4px;width:120px;font-weight:bold;">
                                            <b>MONTH TODATE SALES</b>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="data" t-as="value">
                                        <tr>
                                            <td style="text-align:center; padding:4px; font-weight: normal;">
                                                <span>
                                                    <t t-esc="value['region']"/>
                                                </span>
                                            </td>
                                            <td style="text-align:center; padding:4px; font-weight: normal;">
                                                <span>
                                                    <t t-esc="value['customer_name']"/>
                                                </span>
                                            </td>
                                            <td style="text-align:center; padding:4px; font-weight: normal;">
                                                <span>
                                                    <t t-esc="value['region']"/>
                                                </span>
                                            </td>
                                            <td style="text-align:center; padding:4px; font-weight: normal;">
                                                <span>
                                                    <t t-esc="value['town']"/>
                                                </span>
                                            </td>
                                            <td style="text-align:center; padding:4px; font-weight: normal;">
                                                <span>
                                                    <t t-esc="value['total_target']"/>
                                                </span>
                                            </td>
                                            <td style="text-align:center; padding:4px; font-weight: normal;">
                                                <span>
                                                    <t t-esc="value['sales_todate']"/>
                                                </span>
                                            </td>
                                            
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                </div>
            </t>
        </t>

    </template>
</odoo>