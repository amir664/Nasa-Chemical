<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="customer_target_report">
        <t t-call="web.html_container">
                <div class="page">
                    <h2 style="text-align: center;">Product Report</h2>
                    <table class="table table-bordered" style="width: 100%; margin-top: 20px;">
                        <thead>
                            <tr>
                                <th style="text-align: left;">customer</th>
                                <th style="text-align: left;">Start Date</th>
                                <th style="text-align: left;">End Date</th>
                                <th style="text-align: left;">Sales Target</th>
                                <th style="text-align: left;">Current Sales</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data" t-as="o">
                                <tr>
                                    <td><t t-esc="o.start_date"/></td>
                                    <td><t t-esc="o.end_date"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
        </t>
    </template>
</odoo>
