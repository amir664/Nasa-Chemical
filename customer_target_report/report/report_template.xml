<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="customer_target_reports">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <h2 style="text-align: center;">Customer Target Report</h2>
                    <table class="table table-bordered" style="width: 100%; margin-top: 20px;">
                        <thead>
                            <tr>
                                <th style="text-align: left;">customer</th>
                                <th style="text-align: left;">Start Date</th>
                                <th style="text-align: left;">End Date</th>
                                <th style="text-align: left;">Sales Target</th>
                                <th style="text-align: left;">Current Sales</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data" t-as="test">
                                <tr>
                                    <td><t t-esc="test['customer_name']"/></td>
                                    <td><t t-esc="test['start_date']"/></td>
                                    <td><t t-esc="test['end_date']"/></td>
                                    <td><t t-esc="test['sales_target']"/></td>
                                    <t t-set="lines" t-value="env['customer.target.line'].search([('id','=',test['current_sales'])])"/>
                                    <td><t t-esc="lines.current_sales"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
