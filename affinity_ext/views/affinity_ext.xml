<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_partner_inherited_form" model="ir.ui.view">
            <field name="name">res.partner.inherited.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="category_id" position="after">
                <field name="major_client"/>
                <field name="legal_status"/>
                <field name="company_reg"/>
                <field name="artical"/>
                <field name="town"/>
                
            </field>
            
            <field name="vat" position="after">
                <field name="strn_no"/>
                <field name="region_id"/>
                <field name="sub_region_id"/>
                <field name="status"/>
                <field name="vendor_status"/>
                
                

            </field>
            
            <xpath expr="//field[@name='vat']" position="attributes">
                <attribute name="string">NTN</attribute>
            </xpath>

            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='contact_addresses']/field[@name='child_ids']/form[1]/sheet[1]/group[1]/group[2]/field[@name='phone']" position="after">
                <field name="cnic_no"/>
            </xpath>
    
            <!-- Added IBAN Number  -->
            <!-- <xpath expr="//field[@name='acc_number']" position="after">
                <field name="bank_iban_num" optional="show"/>
            </xpath> -->
                

            </field>
        </record>

       <record id="view_purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='currency_id']" position="after">
                    <!-- <group> -->
                        <!-- <group> -->
                            <field name="due_date"/>
                        <!-- </group> -->
                    <!-- </group> -->
                </xpath>
            </field>
        </record>



        <record id="product_template_inherited_form" model="ir.ui.view">
            <field name="name">product.template.inherited.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">            
                <field name="uom_id" position="after">
                    <field name="purchase_tolerance"/>
                </field>
            </field>
        </record>


        <record id="purchase_request_inherited_form" model="ir.ui.view">
            <field name="name">purchase.request.inherited.form</field>
            <field name="model">purchase.request</field>
            <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[1]/field[@name='line_ids']/tree[1]/field[@name='name']" position="after">
                    
                    <field name="minimum_stock_level" optional="show"/>
                    <!--  -->
                    <field name="forecasting_stock" optional="show"/>
                    <field name="on_hand_qty" optional="show"/>
                </xpath>
                <!-- <field name="description" position="after">
                    <field name="department"/>
                    <field name="date_due"/>
                    <field name="quality_parameters"/>
                </field> -->
            </field>
        </record>
        <record id="qualiy_check_inherited_form" model="ir.ui.view">
            <field name="name">quality.check.inherited.form</field>
            <field name="model">quality.check</field>
            <field name="inherit_id" ref="quality_control.quality_check_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='measure_on']" position="after">
                    <field name="methods"/>
                </xpath>
            </field>
        </record>


        <record id="sale_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="delivery_address"/>
                    <field name="salesperson"/>
                </xpath>
            </field>
        </record>

        <record id="view_sale_order_tree_custom2" model="ir.ui.view">
            <field name="name">sale.order.tree.approval.2</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="approved_by" widget="many2many_tags" string="Approved By"/>
                </xpath>
            </field>
        </record>

        <record id="sale_order_line_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.line.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="after">
                    <field name="discount_in_amount"/>
                    <field name="discount" readonly="1"/>
                </xpath>
                
                <xpath expr="//button[@name='action_confirm']" position="before">
    <button name="action_approve_order" type="object"
        string="Approve" class="oe_highlight"
        modifiers="{'invisible': [('can_approve', '=', False)]}"
    />
</xpath>
<xpath expr="//button[@name='action_confirm']" position="attributes">
    <attribute name="modifiers">{"invisible": [["is_fully_approved", "=", False]]}</attribute>
</xpath>


            </field>
        </record>

        <!-- <record id="sale_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.approve</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_confirm']" position="before">
            <button name="action_approve_order" type="object"
                string="Approve" class="oe_highlight"
                attrs="{'invisible': [('user_id', 'not in', [ref('base.user_amanullah'), ref('base.user_fahad')])]}"/>
        </xpath>
            </field>
        </record> -->



        <record id="view_customer_region_tree" model="ir.ui.view">
            <field name="name">customer.region.tree</field>
            <field name="model">res.customer.region</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="type"/>
                </tree>
            </field>
        </record>

        <record id="view_customer_region_form" model="ir.ui.view">
            <field name="name">customer.region.form</field>
            <field name="model">res.customer.region</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="type"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="customer_region_action" model="ir.actions.act_window">
            <field name="name">Customer Region</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.customer.region</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First Record
                </p>
            </field>
        </record>
        <menuitem id="customer_region_menu_id" name="Customer Region" parent="contacts.res_partner_menu_config" action="customer_region_action" sequence="10"/>


    </data>
</odoo>
    