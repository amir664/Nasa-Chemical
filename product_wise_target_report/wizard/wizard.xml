<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id = "product_wise_target_report_wizard" model="ir.ui.view">
        <field name="name">Product Wise Target Report</field>
        <field name="model">product.wise.target.report</field>
        <field name="arch" type="xml">
            <form string = "Product Wise Target Report">
                <group>
                    <field name = 'customer'/>
                    <field name = 'product'/>
                    <field name = 'start_date' widget="date"/>
                    <field name = 'end_date' widget="date"/>
                </group>
                <footer>
                    <button name="print_report" type="object" string="Print" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="product_wise_target_report_action" model="ir.actions.act_window">
        <field name="name">Product Wise Target Report</field>
        <field name="res_model">product.wise.target.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="product_wise_target_report_id"
              name="Product Wise Target Report"
              parent = "contacts.menu_contacts"
              action="product_wise_target_report_action"
    />
</odoo>