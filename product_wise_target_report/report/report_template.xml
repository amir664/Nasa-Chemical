<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="product_wise_target_reports">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <h2 style="text-align: center;">Product Wise Target Report</h2>
                    <table class="table table-bordered" style="width: 100%; margin-top: 20px;">
                        <thead>
                            <tr>
                                <!-- <th style="text-align: center;">Start Date</th>
                                <th style="text-align: center;">End Date</th> -->
                                <th style="text-align: center;">Customer</th>
                                <th style="text-align: center;">Code</th>
                                <th style="text-align: center;">Product</th>
                                <th style="text-align: center;">Cost</th>
                                <th style="text-align: center;">Target</th>
                                <th style="text-align: center;">In Value</th>
                                
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data" t-as="test">
                                <tr>
                                    <!-- <td><t t-esc="test['start_date']"/></td>
                                    <td><t t-esc="test['end_date']"/></td>  -->
                                    <td><t t-esc="test['res.name']"/></td>
                                    <td><t t-esc="test['product_id']"/></td>
                                    <td><t t-esc="test['pt.name']"/></td>
                                    <td><t t-esc="test['list_price']"/></td>
                                    <td><t t-esc="test['target']"/></td>
                                    <td><t t-esc="test['target * list_price']"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
