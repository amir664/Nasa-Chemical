<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="product_wise_target_reports">
        <t t-call="web.html_container">
              <t t-call="web.external_layout">
                <div class="page">
                    <h2 style="text-align: center;">Product Wise Target Report</h2>
                    <table class="table table-bordered" style="width: 100%; margin-top: 20px;">
                        <thead>
                            <tr>
                                <th style="text-align: center;">Segments</th>
                                <th style="text-align: center;">Code</th>
                                <th style="text-align: center;">Product</th>
                                <th style="text-align: center;">Cost</th>
                                <th style="text-align: center;">Target (Ctn)</th>
                                <th style="text-align: center;">Target (Value)</th>
                                <th style="text-align: center;">Sales Archived (CTN)</th>
                                <th style="text-align: center;">Sales Archived (Value)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data" t-as="test">
                                <tr>
                                    <td>
                                        <t t-if="test.get('product_cat')">
                                            <t t-set="product" t-value="env['product'].search([('id','=',test.get('product_id'))])"/>
                                            <t t-esc="product.product_tag_ids"/>
                                        
                                        </t>
                                        <t t-else="">-</t>
                                    </td>

                                    <td>
                                        <t t-if="test.get('code')">
                                            <t t-esc="test['code']"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>

                                    <td>
                                        <t t-if="test.get('product')">
                                            <t t-esc="test['product']['en_US']"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>

                                    <td class="text-end">
                                        <t t-if="test.get('Cost')">
                                            <t t-set="partner" t-value="env['res.partner'].search([('id','=',test.get('product_cat'))])"/>
                                            <t t-set="segments" t-value="partner.property_product_pricelist.item_ids.filtered(lambda r: r.product_id.id == test.get('product_id'))"/>
                                            <t t-esc="'%.2f'%  segments.fixed_price"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>

                                    <td class="text-end">
                                        <t t-if="test.get('target')">
                                            <t t-esc="'%.2f'% test['target']"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>

                                    <td class="text-end">
                                            <t t-set="partner" t-value="env['res.partner'].search([('id','=',test.get('product_cat'))])"/>
                                            <t t-set="segments" t-value="partner.property_product_pricelist.item_ids.filtered(lambda r: r.product_id.id == test.get('product_id'))"/>
                                            <t t-esc="'%.2f'%  segments.fixed_price * test['target']"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="test.get('sales_date')">
                                            <t t-esc="'%.2f'%  test['sales_date']"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td class="text-end">
                                        <t t-if="test.get('sales_archive')">
                                            <t t-set="partner" t-value="env['res.partner'].search([('id','=',test.get('product_cat'))])"/>
                                            <t t-set="segments" t-value="partner.property_product_pricelist.item_ids.filtered(lambda r: r.product_id.id == test.get('product_id'))"/>
                                            <t t-esc="'%.2f'%  segments.fixed_price * test['sales_archive']"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>

        </t>
    </template>
</odoo>
