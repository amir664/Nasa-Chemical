<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="product_wise_target_reports">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <h2 style="text-align: center;">Product Wise Target Report</h2>
                    <table class="table table-bordered" style="width: 100%; margin-top: 20px;">
                        <thead>
                            <tr>
                                <th style="text-align: center;">Customer</th>
                                <th style="text-align: center;">Code</th>
                                <th style="text-align: center;">Product</th>
                                <th style="text-align: center;">Cost</th>
                                <th style="text-align: center;">Target (Ctn)</th>
                                <th style="text-align: center;">Target (In Value)</th>
                                <th style="text-align: center;">Sales Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data" t-as="test">
                                <tr>
                                    <td>
                                        <t t-if="test.get('Customer')">
                                            <t t-esc="test['Customer']"/>
                                        </t>
                                        <t t-else="">No Name</t>
                                    </td>

                                    <td>
                                        <t t-if="test.get('Code')">
                                            <t t-esc="test['Code']"/>
                                        </t>
                                        <t t-else="">N/A</t>
                                    </td>

                                    <td>
                                        <t t-if="test.get('Product')">
                                            <t t-esc="test['Product']"/>
                                        </t>
                                        <t t-else="">N/A</t>
                                    </td>

                                    <td>
                                        <t t-if="test.get('Cost')">
                                            <t t-esc="test['Cost']"/>
                                        </t>
                                        <t t-else="">0.00</t>
                                    </td>

                                    <td>
                                        <t t-if="test.get('Target')">
                                            <t t-esc="test['Target']"/>
                                        </t>
                                        <t t-else="">0</t>
                                    </td>

                                    <td>
                                        <t t-set="target_value" t-value="test.get('Target', 0)"/>
                                        <t t-set="cost_value" t-value="test.get('Cost', 0)"/>
                                        <t t-esc="target_value * cost_value"/>
                                    </td>
                                    <td>
                                        <t t-if="test.get('sales_date')">
                                            <t t-esc="test['sales_date']"/>
                                        </t>
                                        <t t-else="">0</t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
