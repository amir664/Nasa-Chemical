<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_wizard" model="ir.ui.view">
        <field name="name">Advance to Vendor Report</field>
        <field name="model">advancevendor.report</field>
        <field name="arch" type="xml">
            <form string="Advance to Vendor Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>                        
                    </group>
                    <group>
                        <!-- <field name="item_wise"/> -->
                        <field name="vendor_id"/>
                    </group>
                </group>
                <footer>
                    <button name="generate_excel_report" type="object" string="Print" class="oe_highlight"/>

                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="report_action" model="ir.actions.act_window">
        <field name="name">Advance to Vendor Report</field>
        <field name="res_model">advancevendor.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="report_id"
              name="Advance to Vendor Report"
              parent="purchase.menu_purchase_root"
              action="summary_report_action"
    />
</odoo>
