<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="purchase_manualreports">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="container">
                    <div class="row text-center" style="display: flex; justify-content: center; align-items: center; text-align: center;">

                        <div class="col-12">
                            <h1>NASA CHEMICALS</h1>
                            <br/>
                            <h1>Purchase - Report</h1>
                            <b>From:</b> <t t-esc="other['from_date']"/>
                            <br/>
                            <t t-if="other.get('to_date')">
                                <b>To:</b> <t t-esc="other.get('to_date')"/>
                            </t>
                        </div>
                    </div>
                </div>
                
                <div class="page">
                    <div class="row mt-5 mb-3">
                        <div class="col-12">
                            <table class="table border">
                                <thead>
                                    <tr>
                                        <th class="text-center">Date</th>
                                        <th class="text-center">Vendor</th>
                                        <th class="text-center">PO No</th>
                                        <!-- <th class="text-center">PR No</th> -->
                                        <th class="text-center">GRN</th>
                                        <th class="text-center">Invoice No</th>
                                        <th class="text-center">Received Location</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-center">Unit</th>
                                        <th class="text-center">Price</th>
                                        <th class="text-center">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data" t-as="value">
                                        <td class="text-left"><span t-esc="value['date']"/></td>
                                        <td class="text-left"><span t-esc="value['vendor']"/></td>
                                        <td class="text-left"><span t-esc="value['pono']"/></td>
                                        <!-- <td class="text-left"><span t-esc="value['purchaserequest']"/></td> -->
                                        <td class="text-left"><span t-esc="value['grn']"/></td>
                                        <td class="text-left"><span t-esc="value['invoiceno']"/></td>
                                        <td class="text-left"><span t-esc="value['location']"/></td>
                                        <td class="text-right"><span t-esc="value['qty']"/></td>
                                        <td class="text-right"><span t-esc="value['unit']"/></td>
                                        <td class="text-right"><span t-esc="value['price']"/></td>
                                        <td class="text-right"><span t-esc="value['amount']"/></td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="text-right"><b>Totals</b></td>
                                        <td class="text-right"><b><span t-esc="totals['total_qty']" t-options='{"widget": "float", "precision": 2, "thousands_sep": ","}'/></b></td>
                                        <td></td>
                                        <td class="text-right"><b><span t-esc="totals['total_price']" t-options='{"widget": "float", "precision": 2, "thousands_sep": ","}'/></b></td>
                                        <td class="text-right"><b><span t-esc="totals['total_amount']" t-options='{"widget": "float", "precision": 2, "thousands_sep": ","}'/></b></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
