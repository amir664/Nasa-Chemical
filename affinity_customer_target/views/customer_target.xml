<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_target_tree" model="ir.ui.view">
        <field name="name">customer.target.tree</field>
        <field name="model">customer.target</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <record id="view_customer_target_form" model="ir.ui.view">
        <field name="name">customer.target.form</field>
        <field name="model">customer.target</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <field name="customer"/>
                        <field name="sales_person"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable='bottom'>
                                    <field name = "product_id"/>
                                    <field name = "target"/>
                                </tree>
                            </field>    
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="customer_form_inherited_form" model="ir.ui.view">
            <field name="name">res.partner.inherited.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <!-- <button class="oe_stat_button" type="object" name="action_view_sale_order" groups="sales_team.group_sale_salesman" icon="fa-usd">
                    <field string="Sales" name="sale_order_count" widget="statinfo"/>
                </button> -->
                    <button class="oe_stat_button" icon="fa-area-chart" type="object" name="open_customer_targets" context="{'default_customer': active_id}" >
                        <field widget="statinfo" name="target_count" string="Target"/>
                    </button>
            </div>
                <!-- <xpath expr="//button[@name='action_view_sale_order']" position="after">
                </xpath> -->
                
            </field>
        </record>




    <record id="action_customer_target" model = "ir.actions.act_window">
        <field name="name">Customer Target</field>
        <field name="res_model">customer.target</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_customer_target"
              name="Customer Target"
              action="action_customer_target"
              parent = "contacts.menu_contacts"/> -->
</odoo>
