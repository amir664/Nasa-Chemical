<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_target_tree" model="ir.ui.view">
        <field name="name">customer.target.tree</field>
        <field name="model">customer.target</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <record id="view_customer_target_form" model="ir.ui.view">
        <field name="name">customer.target.form</field>
        <field name="model">customer.target</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable='bottom'>
                                    <field name = "customer"/>
                                    <field name = "target"/>
                                </tree>
                            </field>    
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_customer_target" model = "ir.actions.act_window">
        <field name="name">Customer Target</field>
        <field name="res_model">customer.target</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_customer_target"
              name="Customer Target"
              action="action_customer_target"/>
</odoo>
