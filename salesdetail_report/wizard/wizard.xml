<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="salesdetail_report_wizard" model="ir.ui.view">
        <field name="name">Sales Detail Report</field>
        <field name="model">salesdetail.report</field>
        <field name="arch" type="xml">
            <form string="Sales Detail Report">
                <group>
                   <group>
                        <field name="from_date"/>
                        <field name="to_date"/>
                        <field name="partner_ids" />
                            <!-- #widget="many2many_tags" -->


                        <field name="category_ids"/>    
                    </group>
                   <group>
                        <field name="partner_tag_ids"/>
                        <field name="city"/>
                        <field name="branch"/>
                        <field name="area"/>    
                    </group>
                </group>
                <footer>
                    <button name="print_report" type="object" string="Print" class="oe_highlight"/>
                    <button name="print_excel_report" type="object" string="Export To Excel" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="salesdetail_report_action" model="ir.actions.act_window">
        <field name="name">Sales Detail Report</field>
        <field name="res_model">salesdetail.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="salesdetail_report_id"
              name="Sales Detail Report"
              parent="account.menu_finance_reports"
              action="salesdetail_report_action"
    />
</odoo>