<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="summary_report_wizard" model="ir.ui.view">
        <field name="name">Purchase Order Summary Report</field>
        <field name="model">summary.report</field>
        <field name="arch" type="xml">
            <form string="Purchase Order Summary Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>                        
                    </group>
                    <group>
                        <field name="item_wise"/>
                        <field name="vendor_id"/>
                    </group>
                </group>
                <footer>
                    <button name="generate_excel_report" type="object" string="Print" class="oe_highlight"/>

                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="summary_report_action" model="ir.actions.act_window">
        <field name="name">Purchase Order Summary Report</field>
        <field name="res_model">summary.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="summary_report_id"
              name="Purchase Order Summary Report"
              parent="purchase.menu_purchase_root"
              action="summary_report_action"
    />
</odoo>
