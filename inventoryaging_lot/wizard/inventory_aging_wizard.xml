<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- model.name form view -->
<record id="inventoryaging_lot_wizard_view" model="ir.ui.view">
    <field name="name">inventoryaging.lot.wizard.view.form</field>
    <field name="model">inventoryaging.lot</field>
    <field name="arch" type="xml">
        <form string="Inventory Aging Wizard">
            
            <group>
                <!-- Add your fields here -->
                <!-- <field name="start_date"/> -->
                <!-- <field name='end_date'/> -->
                <group>

                    <field name="date_from"/>
                    <field name="product_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True}"/>
                    <field name="category_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True}"/>
                </group>
                
                <group>
                    <field name="date_to"/>
                    <field name="location_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True}"/>
                    <field name="lot_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True}"/>
                </group>
            </group>
            <footer>
                    <!-- <button name="print_report" type="object" string="Print PDF" class="oe_highlight"/> -->
                    <button name="generate_report" type="object" string="Print Excel" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
            </footer>
        </form>
    </field>
</record>
<!-- model.name action window -->
<record id="inventoryaging_lot_wizard_action" model="ir.actions.act_window">
    <field name="name">Inventory Aging Wizard</field>
    <field name="res_model">inventoryaging.lot</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>


<menuitem id="inventoryaging_lot_id"
              name="Lot Wise Inventory Aging"
              parent="account.menu_finance_reports"
              action="inventoryaging_lot_wizard_action"
    />
</odoo>