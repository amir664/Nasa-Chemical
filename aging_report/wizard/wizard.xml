<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aging_report_wizard" model="ir.ui.view">
        <field name="name">Aging Report</field>
        <field name="model">aging2.report</field>
        <field name="arch" type="xml">
            <form string="Aging Report">
                <group>
                   <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        
                        
                    </group>
                   <group>
                        <field name="vendor_ids" widget="many2many_tags"/>
                        <field name="invoice"/>
                    </group>
                </group>
                <footer>
                    <button name="print_report" type="object" string="Print" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="aging_report_action" model="ir.actions.act_window">
        <field name="name">Aging Report</field>
        <field name="res_model">aging2.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="aging_report_id"
              name="Aging Report"
              parent="account.menu_finance_reports"
              action="aging_report_action"
    />
</odoo>